    "db:migrate": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "@sentry/nextjs": "^10.0.0",
    "@uploadthing/react": "^7.3.3",
    "better-auth": "^1.7.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "heic2any": "^0.0.4",
    "lucide-react": "^0.540.0",
    "mongodb": "^6.22.0",
    "motion": "^12.23.0",
    "next": "^15.5.0",
    "posthog-js": "^1.260.0",
    "radix-ui": "^1.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^6.0.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "unpdf": "^1.6.2",
    "uploadthing": "^7.7.4",
    "zod": "^4.1.0"
