# Copy to .env.local and fill in. Never commit .env.local.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000   # on Vercel: https://wayzo-cyan.vercel.app
NEXT_PUBLIC_SITE_NAME=Wayzo
# Long random string (e.g. `openssl rand -base64 48`). Signs email-verification links.
APP_SECRET=

# Database: Neon Postgres (trips, members, bookings, AI usage). neon.tech -> project -> Connect (pooled)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Logins: Better Auth, with users and sessions stored in MongoDB Atlas (cloud.mongodb.com, free M0)
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/wayzo?retryWrites=true&w=majority
BETTER_AUTH_SECRET=              # long random string: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_URL=http://localhost:3000   # the site's public URL (e.g. https://wayzo-cyan.vercel.app)
BETTER_AUTH_TRUSTED_ORIGINS=     # optional extra origins, comma-separated (e.g. a custom domain)
GOOGLE_CLIENT_ID=                # optional: "Continue with Google" appears when both are set
GOOGLE_CLIENT_SECRET=

# File uploads: UploadThing (uploadthing.com -> app -> API Keys)
UPLOADTHING_TOKEN=

# AI (server only). Any OpenAI-compatible API; OpenRouter free models during development.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=                      # sk-or-v1-... from openrouter.ai/settings/keys
AI_MODELS=nvidia/nemotron-3.5-super-vl:free,particle-ai/particle-1:free,openrouter/free   # tried in order
AI_DAILY_CALL_CAP_FREE=40        # per user per day

# Places (server only, both optional; without them destinations are free text + branded covers)
GEOAPIFY_API_KEY=                # city search: geoapify.com (free 3,000 requests/day)
UNSPLASH_ACCESS_KEY=             # trip cover photos: unsplash.com/developers (free)

# Weather & currency
OPENWEATHER_API_KEY=
FX_API_KEY=

# Email
RESEND_API_KEY=
EMAIL_FROM=                       # e.g. "Wayzo <hello@yourdomain.com>" once the domain is verified in Resend
INBOUND_EMAIL_DOMAIN=                # set together with the public one below
NEXT_PUBLIC_INBOUND_EMAIL_DOMAIN=   # leave empty until you own a domain (trip email addresses show "coming soon")
INBOUND_WEBHOOK_SECRET=

# Web push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@wayzo.app

# Affiliates
AFFILIATE_BOOKING_ID=
AFFILIATE_AGODA_ID=

# Cron
CRON_SECRET=

# Monitoring (both optional; SDKs only load when set)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
